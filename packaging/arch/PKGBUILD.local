# Maintainer: William C. Canin
pkgname=argvus-lock
pkgver=0.1.0
pkgrel=1
pkgdesc="Hyprlock configuration and lock screen integration for the ARGVUS desktop."
arch=('any')
url="https://github.com/argvus/argvus-lock"
license=('GPL-3.0-only')
depends=(
  'argvus-appearance'
  'argvus-i18n'
  'argvus-session'
  'hyprlock'
  'ttf-jetbrains-mono-nerd'
  'ttf-nerd-fonts-symbols-mono'
)
optdepends=(
  'argvus-power: idle lock, lock menu and DPMS policy integration'
)
options=('!debug')
source=("${pkgname}-${pkgver}.tar.gz")
sha256sums=("SKIP")

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" PREFIX=/usr install
}
